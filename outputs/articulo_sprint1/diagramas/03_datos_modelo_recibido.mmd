erDiagram
 cabana {
  long id_cabana PK
  string nombre
  decimal precio_base_noche
  string estado
 }
 cabana_imagenes {
  long id_imagen PK
  long id_cabana FK
  string url_imagen
 }
 cabana_comodidades {
  long id_comodidad PK
  long id_cabana FK
  string nombre_comodidad
 }
 reserva {
  long id_reserva PK
  long id_cabana
  long id_usuario
  date fecha_ingreso
  date fecha_salida
  decimal monto_total
  decimal monto_adelanto
