 }
 usuario {
  long id_usuario PK
 }
 transaccion_pago {
  long id_transaccion PK
  long id_reserva
  string id_externo_pasarela UK
  decimal monto
  string estado_transaccion
 }
 webhook_log {
  long id_log PK
