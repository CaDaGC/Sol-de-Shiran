{
  "info": {
    "name": "HU19 - Metricas de ventas y reservas",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Consultas de solo lectura a traves del API Gateway. Configura adminToken y clienteToken con JWT de prueba; no guardes contrasenas en la coleccion."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8061/api/v1" },
    { "key": "adminToken", "value": "" },
    { "key": "clienteToken", "value": "" },
    { "key": "desde", "value": "2026-11-01" },
    { "key": "hasta", "value": "2026-11-30" }
  ],
  "item": [
    {
      "name": "01 Ingresos aprobados del periodo",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
        "url": "{{baseUrl}}/pagos/metricas/ingresos?desde={{desde}}&hasta={{hasta}}"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
        "const data = pm.response.json();",
        "pm.test('Resumen de ingresos', () => { pm.expect(data.totalIngresos).to.be.a('number'); pm.expect(data.numeroPagos).to.be.a('number'); pm.expect(data.ingresosPorDia).to.be.an('array'); });",
        "pm.test('Total coincide con los dias', () => { const suma = data.ingresosPorDia.reduce((acc, dia) => acc + dia.total, 0); pm.expect(Math.abs(suma - data.totalIngresos)).to.be.below(0.01); });"
      ] } }]
    },
    {
      "name": "02 Frecuencia de reservas por cabana",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
        "url": "{{baseUrl}}/reservas/metricas/frecuencia?desde={{desde}}&hasta={{hasta}}"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
        "const data = pm.response.json();",
        "pm.test('Ranking y total coherentes', () => { pm.expect(data.ranking).to.be.an('array'); pm.expect(data.totalReservas).to.eql(data.ranking.reduce((acc, cabana) => acc + cabana.reservas, 0)); });"
      ] } }]
    },
    {
      "name": "03 Nombres de cabanas para el dashboard",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
        "url": "{{baseUrl}}/cabanas/gestion"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
        "pm.test('Lista de cabanas', () => pm.expect(pm.response.json()).to.be.an('array'));"
      ] } }]
    },
    {
      "name": "04 Cliente no puede consultar ingresos",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{clienteToken}}" }],
        "url": "{{baseUrl}}/pagos/metricas/ingresos?desde={{desde}}&hasta={{hasta}}"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('HTTP 403', () => pm.response.to.have.status(403));"
      ] } }]
    },
    {
      "name": "05 Rechazar fechas invertidas",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
        "url": "{{baseUrl}}/reservas/metricas/frecuencia?desde={{hasta}}&hasta={{desde}}"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('HTTP 400', () => pm.response.to.have.status(400));"
      ] } }]
    }
  ]
}
